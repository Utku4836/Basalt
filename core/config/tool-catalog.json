      ],
      "sharedModels": [
        ".cursor/models*.json"
      ],
      "sharedConfig": [
        ".cursor/cli-config.json"
      ],
      "sharedSkills": [
        ".cursor/skills"
      ]
    },
    "mcp": {
      "path": ".cursor/mcp.json",
      "format": "file"
    },
    "permission_args": [
      "--yolo"
    ]
  },
  {
    "id": "amp",
